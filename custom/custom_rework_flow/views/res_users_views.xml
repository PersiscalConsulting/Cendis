<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expone el PIN de autorizacion de re-proceso en la pestaña
         "Account Security" del formulario del usuario (solo admin). -->
    <record id="view_users_form_inherit_rework" model="ir.ui.view">
        <field name="name">res.users.form.rework</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account_security']" position="inside">
                <group string="PIN de autorizacion (Volver a preparar)">
                    <field name="rework_auth_pin" password="True"
                           groups="base.group_system"
                           placeholder="PIN corto para autorizar re-procesos"
                           />
                </group>
            </xpath>
        </field>
    </record>

</odoo>