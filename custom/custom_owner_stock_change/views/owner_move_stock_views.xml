<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_owner_move_scan_owl" model="ir.actions.client">
        <field name="name">Escanear</field>
        <field name="tag">custom_owner_stock_change.owner_move_scan_action</field>
    </record>

    <record id="view_owner_move_stock_tree" model="ir.ui.view">
        <field name="name">owner.move.stock.tree</field>
        <field name="model">owner.move.stock</field>
        <field name="arch" type="xml">
            <list string="Movimientos entre Propietarios">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="dest_owner_id"/>
                <field name="user_id"/>
                <field name="date_start"/>
                <field name="scanned_qty" string="Cantidad"/>
                <field name="package_count" string="Paquetes"/>
                <field name="stage_id"/>
                <field name="state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_owner_move_stock_form" model="ir.ui.view">
        <field name="name">owner.move.stock.form</field>
        <field name="model">owner.move.stock</field>
        <field name="arch" type="xml">
            <form string="Movimiento entre Propietarios">
                <header>
                    <button name="action_start_scan" type="object"
                            string="Iniciar Escaneo" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_resume_scan" type="object"
                            string="Volver al Escaneo" class="oe_highlight"
                            invisible="state != 'waiting'"/>
                    <button name="%(action_validate_move)d" type="action"
                            string="Validar" class="oe_highlight"
                            invisible="state != 'available'"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_packages" type="object"
                                class="oe_stat_button" icon="fa-cube"
                                invisible="state != 'available'">
                            <field name="package_count" widget="statinfo" string="Paquetes"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="owner_id" readonly="state != 'draft'"/>
                            <field name="dest_owner_id" readonly="state != 'draft'"/>
                            <field name="dest_supplier_id" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="dest_contact_id"/>
                            <field name="origin_doc"/>
                            <field name="exit_remito"/>
                            <field name="out_picking_id" readonly="1"/>
                            <field name="in_picking_id" readonly="1"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="scanned_location_ids" widget="many2many_tags"
                                   readonly="1" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Lineas" name="lines">
                            <field name="line_ids" readonly="state not in ('waiting', 'available')">
                                <list string="Lineas">
                                    <field name="product_id"/>
                                    <field name="qty" string="Cantidad Preparada"/>
                                    <field name="packed_qty" string="Empaquetado"/>
                                    <field name="uom_id"/>
                                    <field name="location_ids" widget="many2many_tags"
                                           string="Ubicaciones"/>
                                    <field name="package_count" string="Paquetes"/>
                                </list>
                                <form string="Linea">
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="qty"/>
                                            <field name="uom_id"/>
                                        </group>
                                        <group>
                                            <field name="owner_id" readonly="1"/>
                                            <field name="dest_owner_id" readonly="1"/>
                                            <field name="location_ids" widget="many2many_tags"
                                                   readonly="1"/>
                                            <field name="package_count" readonly="1"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="Detalles Escaneados" name="details">
                                            <field name="detail_ids" readonly="1">
                                                <list string="Detalles">
                                                    <field name="location_id"/>
                                                    <field name="lot_id" groups="stock.group_production_lot"/>
                                                    <field name="expiration_date"/>
                                                    <field name="qty"/>
                                                    <field name="uom_id"/>
                                                    <field name="package_id"/>
                                                    <field name="weight" string="Peso"/>
                                                    <field name="owner_id" string="Owner Origen"/>
                                                </list>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page string="Detalles" name="details">
                            <field name="detail_ids" readonly="1">
                                <list string="Detalles Escaneados">
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="lot_id" groups="stock.group_production_lot"/>
                                    <field name="expiration_date"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="package_id"/>
                                    <field name="weight" string="Peso"/>
                                    <field name="owner_id" string="Owner Origen"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <xpath expr="//sheet" position="after">
                        <chatter/>
                    </xpath>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_owner_move_stock" model="ir.actions.act_window">
        <field name="name">Movimientos entre Propietarios</field>
        <field name="res_model">owner.move.stock</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_owner_move_stock"
              name="Movimientos entre Propietarios"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_owner_move_stock"
              sequence="40"/>

</odoo>
