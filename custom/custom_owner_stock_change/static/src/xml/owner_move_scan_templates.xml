<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="custom_owner_stock_change.OwnerMoveScanAction">

        <div t-if="state.loading" class="o_owner_move_loading">
            <i class="fa fa-spinner fa-spin"/> Cargando operacion...
        </div>

        <div t-else="" class="o_owner_move_container">

            <div class="o_owner_move_header">
                <div class="o_owner_move_top_row">
                    <button class="btn btn-link o_owner_move_back_btn" t-on-click="onBack">
                        <i class="fa fa-arrow-left"/> Volver
                    </button>
                    <div class="o_owner_move_title">
                        <h2><i class="fa fa-exchange"/> Movimiento entre Propietarios</h2>
                        <span t-if="state.move" class="o_owner_move_name">
                            <t t-esc="state.move.name"/>
                        </span>
                    </div>
                </div>

                <div t-if="state.move" class="o_owner_move_meta">
                    <span class="o_owner_move_meta_badge o_owner_move_meta_badge--origin">
                        Origen: <t t-esc="state.move.owner_id ? state.move.owner_id[1] : '-'"/>
                    </span>
                    <span class="o_owner_move_meta_badge o_owner_move_meta_badge--dest">
                        Destino: <t t-esc="state.move.dest_owner_id ? state.move.dest_owner_id[1] : '-'"/>
                    </span>
                </div>

                <div t-if="state.currentScanLocation" class="o_owner_move_current_location">
                    <i class="fa fa-map-marker"/> Escaneando en: <strong t-esc="state.currentScanLocation.name"/>
                </div>

                <div t-if="state.isFinished" class="o_owner_move_finished_banner">
                    <i class="fa fa-lock"/>
                    Esta operacion ya no esta en escaneo. Regrese al formulario.
                </div>

                <div t-att-class="'o_owner_move_message alert alert-' + state.messageType"
                     t-if="state.message" role="alert">
                    <i t-att-class="'fa ' + (
                        state.messageType === 'success' ? 'fa-check-circle' :
                        state.messageType === 'danger' ? 'fa-exclamation-triangle' :
                        state.messageType === 'warning' ? 'fa-exclamation-circle' :
                        'fa-info-circle')"/>
                    <t t-esc="state.message"/>
                </div>

                <div t-if="state.currentBarcode" class="o_owner_move_last_scan">
                    <span class="label">Ultimo escaneo:</span>
                    <span class="barcode-value" t-esc="state.currentBarcode"/>
                </div>
            </div>

            <t t-if="!state.isFinished">
                <div class="o_owner_move_scan_area">
                    <div class="o_owner_move_scanner_icon">
                        <i class="fa fa-barcode fa-3x"/>
                        <p t-if="!state.locationScanned">Escanee la ubicacion para comenzar</p>
                        <p t-else="">Escanee una ubicacion, un lote o un producto</p>
                    </div>
                </div>

                <div class="o_owner_move_manual_input">
                    <input type="text" class="form-control" placeholder="Escriba o escanee un codigo de barras..."
                           t-att-value="state.barcodeInput"
                           t-on-input="onBarcodeInput"
                           t-on-keydown="onInputKeydown"/>
                    <button class="btn btn-primary" t-on-click="onSubmitBarcode">
                        <i class="fa fa-plus"/> Agregar
                    </button>
                </div>
            </t>

            <div class="o_owner_move_summary">
                <h3>Resumen por Producto (<t t-esc="state.summaryLines.length"/>)</h3>
                <t t-if="state.summaryLines.length > 0">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-right">Cantidad</th>
                                <th class="text-right">Empaquetado</th>
                                <th>Ubicaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.summaryLines" t-as="line" t-key="line.product_id_db">
                                <tr>
                                    <td><t t-esc="line.product_name"/></td>
                                    <td class="text-right"><strong t-esc="line.qty"/></td>
                                    <td class="text-right"><t t-esc="line.packed_qty"/></td>
                                    <td>
                                        <span t-foreach="line.locations" t-as="loc"
                                              t-key="line.product_id_db + loc"
                                              class="o_owner_move_loc_badge">
                                            <t t-esc="loc"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <div t-else="" class="o_owner_move_no_lines">
                    <p>Aun no se han escaneado productos.</p>
                </div>
            </div>

            <div t-if="!state.isFinished" class="o_owner_move_pack">
                <h3>Seleccion para Empaquetar</h3>
                <div class="o_owner_move_pack_actions">
                    <button class="btn btn-secondary btn-sm" t-on-click="onSelectLatest">
                        <i class="fa fa-check-square"/> Seleccionar ultimas lineas
                    </button>
                    <button class="btn btn-secondary btn-sm" t-on-click="onDeselectAll">
                        <i class="fa fa-square-o"/> Deseleccionar todo
                    </button>
                    <button class="btn btn-primary btn-sm" t-on-click="onPack"
                            t-att-disabled="selectedCount === 0">
                        <i class="fa fa-cube"/> Empaquetar seleccionadas (<t t-esc="selectedCount"/>)
                    </button>
                </div>

                <t t-if="state.details.length > 0">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Sel.</th>
                                <th>Producto</th>
                                <th>Lote/Serie</th>
                                <th>Ubicacion</th>
                                <th class="text-right">Cantidad</th>
                                <th>Paquete</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.details" t-as="d" t-key="d.id">
                                <tr t-att-class="d.packed ? 'o_owner_move_row_packed' : ''">
                                    <td>
                                        <CheckBox value="d.selected"
                                                  disabled="d.packed"
                                                  onChange="(checked) => onToggleSelection(d, checked)"/>
                                    </td>
                                    <td><t t-esc="d.product_name"/></td>
                                    <td><t t-esc="d.lot_name || '-'"/></td>
                                    <td><t t-esc="d.location_name"/></td>
                                    <td class="text-right">
                                        <t t-if="state.manualQtyEnabled &amp;&amp; !d.packed">
                                            <input type="text" inputmode="decimal"
                                                   t-attf-value="#{d.qty}"
                                                   class="form-control form-control-sm o_owner_move_qty_input"
                                                   t-on-change="(ev) => onChangeQty(d, ev)"/>
                                        </t>
                                        <span t-else="">
                                            <t t-esc="d.qty"/>
                                        </span>
                                    </td>
                                    <td>
                                        <span t-if="d.package_name" class="o_owner_move_pkg_badge">
                                            <i class="fa fa-cube"/> <t t-esc="d.package_name"/>
                                        </span>
                                        <span t-else="" class="text-muted">Sin paquete</span>
                                    </td>
                                    <td>
                                        <button t-if="state.allowDeleteEnabled &amp;&amp; !d.packed"
                                                class="btn btn-sm btn-link o_owner_move_delete_btn"
                                                t-on-click="() => onDeleteDetail(d)"
                                                title="Eliminar linea">
                                            <i class="fa fa-trash"/>
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <div t-else="" class="o_owner_move_no_lines">
                    <p>Sin detalles escaneados.</p>
                </div>
            </div>

            <div t-if="!state.isFinished" class="o_owner_move_footer">
                <button class="btn btn-primary btn-lg" t-on-click="onFinish"
                        t-att-disabled="state.details.length === 0 || !state.locationScanned">
                    <i class="fa fa-check"/> Finalizar
                </button>
                <button class="btn btn-secondary btn-lg" t-on-click="onCancel">
                    <i class="fa fa-times"/> Cancelar
                </button>
            </div>

        </div>
    </t>

    <t t-name="custom_owner_stock_change.OwnerMoveErrorDialog">
        <div class="o_owner_move_error_dialog">
            <div class="o_owner_move_error_dialog_title">
                <i class="fa fa-exclamation-triangle"/>
                <span t-esc="props.title"/>
            </div>
            <ul class="o_owner_move_error_dialog_list">
                <li t-foreach="props.errors" t-as="line" t-key="line_index">
                    <t t-esc="line"/>
                </li>
            </ul>
            <div class="o_owner_move_error_dialog_footer">
                <button class="btn btn-secondary btn-sm" t-on-click="props.close">
                    Cerrar
                </button>
            </div>
        </div>
    </t>

</templates>
