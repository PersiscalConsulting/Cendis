<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_review_stage_list" model="ir.ui.view">
        <field name="name">review.stage.list</field>
        <field name="model">review.stage</field>
        <field name="arch" type="xml">
            <list string="Etapas de Repaso">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
                <field name="is_initial"/>
                <field name="is_final"/>
                <field name="is_cancel"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="view_review_stage_form" model="ir.ui.view">
        <field name="name">review.stage.form</field>
        <field name="model">review.stage</field>
        <field name="arch" type="xml">
            <form string="Etapa de Repaso">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="is_initial"/>
                            <field name="is_final"/>
                            <field name="is_cancel"/>
                            <field name="fold"/>
                            <field name="color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_review_stage" model="ir.actions.act_window">
        <field name="name">Etapas de Repaso</field>
        <field name="res_model">review.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_review_stage"
              name="Etapas de Repaso"
              parent="stock.menu_stock_config_settings"
              action="action_review_stage"
              sequence="71"/>

</odoo>
