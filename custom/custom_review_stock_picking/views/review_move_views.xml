<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_review_move_form" model="ir.ui.view">
        <field name="name">review.move.form</field>
        <field name="model">review.move</field>
        <field name="arch" type="xml">
            <form string="Linea de Repaso">
                <sheet>
                    <div class="oe_title">
                        <h3><field name="product_id" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="review_id" readonly="1"/>
                            <field name="stock_move_id" readonly="1" optional="hide"/>
                            <field name="owner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="qty_preparation" readonly="1"/>
                            <field name="qty_packaged" readonly="1"/>
                            <field name="qty_remaining" readonly="1"/>
                            <field name="total_weight" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalles por Lote" name="move_lines">
                            <field name="move_line_ids">
                                <list string="Detalles" editable="bottom">
                                    <field name="can_manual_packaging" column_invisible="1"/>
                                    <field name="can_manual_review" column_invisible="1"/>
                                    <field name="lot_id"/>
                                    <field name="expiration_date" readonly="1"/>
                                    <field name="qty"/>
                                    <field name="qty_reviewed" readonly="not can_manual_review"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="location_id" readonly="1" optional="hide"/>
                                    <field name="location_dest_id" readonly="1" optional="hide"/>
                                    <field name="weight" readonly="1" optional="show"/>
                                    <field name="state" readonly="1"/>
                                    <field name="package_id" readonly="not can_manual_packaging"/>
                                    <field name="owner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
