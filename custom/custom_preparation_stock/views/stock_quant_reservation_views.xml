<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- VISTA LISTA                                                   -->
    <!-- ============================================================ -->
    <record id="view_stock_quant_reservation_list" model="ir.ui.view">
        <field name="name">stock.quant.reservation.list</field>
        <field name="model">stock.quant.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservas de Inventario"
                  decoration-info="state == 'reserved'"
                  decoration-muted="state == 'released'"
                  decoration-danger="state == 'reserved' and release_date and (now - release_date).seconds &lt; 300">
                <field name="create_date" string="Reservado desde" readonly="1"/>
                <field name="preparation_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="owner_id"/>
                <field name="qty" readonly="1"/>
                <field name="user_id" readonly="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'released'"
                       decoration-warning="state == 'reserved'"/>
                <field name="release_reason" readonly="1"/>
                <field name="release_date" readonly="1"/>
                <button name="action_release_manual"
                        string="Liberar"
                        type="object"
                        class="btn-danger"
                        icon="fa-unlock"
                        invisible="state != 'reserved'"
                        confirm="Desea liberar esta reserva?"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- VISTA FORMULARIO                                               -->
    <!-- ============================================================ -->
    <record id="view_stock_quant_reservation_form" model="ir.ui.view">
        <field name="name">stock.quant.reservation.form</field>
        <field name="model">stock.quant.reservation</field>
        <field name="arch" type="xml">
            <form string="Reserva de Inventario" create="false" delete="false">
                <header>
                    <button name="action_release_manual"
                            string="Liberar Reserva"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'reserved'"
                            confirm="Desea liberar esta reserva?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group string="Estado">
                            <field name="state" widget="badge"
                                   decoration-success="state == 'released'"
                                   decoration-warning="state == 'reserved'"/>
                            <field name="release_reason" readonly="1"/>
                            <field name="release_date" readonly="1"/>
                        </group>
                        <group string="Stock">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="owner_id"/>
                            <field name="qty"/>
                        </group>
                    </group>
                    <group>
                        <group string="Operacion">
                            <field name="preparation_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Auditoria">
                            <field name="user_id"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- VISTA BUSQUEDA                                                 -->
    <!-- ============================================================ -->
    <record id="view_stock_quant_reservation_search" model="ir.ui.view">
        <field name="name">stock.quant.reservation.search</field>
        <field name="model">stock.quant.reservation</field>
        <field name="arch" type="xml">
            <search string="Buscar Reservas">
                <field name="preparation_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="owner_id"/>
                <field name="user_id"/>
                <filter name="filter_reserved" string="Reservados"
                        domain="[('state', '=', 'reserved')]"/>
                <filter name="filter_released" string="Liberados"
                        domain="[('state', '=', 'released')]"/>
                <group expand="0" string="Agrupar">
                    <filter name="group_preparation" string="Preparacion" context="{'group_by': 'preparation_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_owner" string="Propietario" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_user" string="Operador" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACCION                                                        -->
    <!-- ============================================================ -->
    <record id="action_stock_quant_reservation" model="ir.actions.act_window">
        <field name="name">Reservas de Inventario</field>
        <field name="res_model">stock.quant.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_quant_reservation_search"/>
        <field name="context">{'search_default_filter_reserved': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay reservas activas</p>
            <p>Las reservas se crean automaticamente cuando un operador escanea mercaderia durante la preparacion.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- MENU                                                          -->
    <!-- ============================================================ -->
    <menuitem id="menu_stock_quant_reservation"
              name="Reservas de Inventario"
              parent="stock.menu_stock_config_settings"
              action="action_stock_quant_reservation"
              sequence="65"/>

</odoo>
