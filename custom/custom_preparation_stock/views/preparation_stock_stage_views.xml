<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_preparation_stock_stage_list" model="ir.ui.view">
        <field name="name">preparation.stock.stage.list</field>
        <field name="model">preparation.stock.stage</field>
        <field name="arch" type="xml">
            <list string="Etapas de Preparacion">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="view_preparation_stock_stage_form" model="ir.ui.view">
        <field name="name">preparation.stock.stage.form</field>
        <field name="model">preparation.stock.stage</field>
        <field name="arch" type="xml">
            <form string="Etapa de Preparacion">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="fold"/>
                            <field name="color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_preparation_stock_stage" model="ir.actions.act_window">
        <field name="name">Etapas de Preparación</field>
        <field name="res_model">preparation.stock.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_preparation_stock_stage"
              name="Etapas de Preparación"
              parent="stock.menu_stock_config_settings"
              action="action_preparation_stock_stage"
              sequence="61"/>

</odoo>
